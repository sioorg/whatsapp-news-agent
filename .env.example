# --- LLM ---------------------------------------------------------------
# groq | anthropic
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Conversation store ----------------------------------------------
# Path to the SQLite history DB. Empty = in-memory, lost on restart.
# In Docker this points at the mounted volume.
CHECKPOINT_DB=

# --- Tavily ------------------------------------------------------------
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=5
TAVILY_SEARCH_DAYS=7

# --- Local knowledge base (router + RAG) --------------------------------
# Path to the SQLite vector store. Empty = in-memory, lost on restart, same
# tradeoff as CHECKPOINT_DB above. In Docker this points at the mounted
# volume too.
RAG_DB_PATH=
# fastembed model: local, CPU-only, free, no API key. Change the dims below
# too if you change this to a model with a different output size.
RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAG_EMBEDDING_DIMS=384
# Where the ~130MB model is cached after its first download. Empty = an
# ephemeral default location, redownloaded on every container restart.
RAG_MODEL_CACHE_DIR=
RAG_TOP_K=4

# --- Meta WhatsApp Cloud API (primary) ---------------------------------
# From Meta App dashboard -> WhatsApp -> API Setup
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
# Any string you invent; paste the same value into Meta's callback config.
META_VERIFY_TOKEN=
# App dashboard -> Settings -> Basic -> App Secret
META_APP_SECRET=
META_GRAPH_VERSION=v21.0
# Turn on once you have a stable https URL.
VALIDATE_META_SIGNATURE=false

# --- Twilio WhatsApp (alternative; needs an UPGRADED account) ----------
# Trial accounts cannot send custom replies: free-form REST returns
# 21654 ContentSid Required, the Content API is blocked, and inline TwiML
# is unsupported.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sandbox number. Replace once you have your own WhatsApp sender.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Set to true in production, and set PUBLIC_BASE_URL to your https origin
# exactly as Twilio calls it (e.g. https://abc123.ngrok-free.app).
VALIDATE_TWILIO_SIGNATURE=false
PUBLIC_BASE_URL=

# --- OpenAI-compatible web connector (e.g. Open WebUI) ------------------
# A long random secret, e.g. `openssl rand -hex 32`. This is the ONLY thing
# gating /v1/models and /v1/chat/completions — those routes live on the same
# public hostname as everything else in this app (there's no path-level
# restriction at the tunnel), so treat this exactly like a real API key, not
# a formality. Paste the same value into your frontend's connection config.
OPENAI_COMPAT_API_KEY=

# --- Prometheus metrics (GET /metrics) ----------------------------------
# A separate long random secret (same generation method as above) — its own
# key rather than reusing OPENAI_COMPAT_API_KEY, so rotating one never
# breaks the other. Same "real access control, not a formality" caveat:
# this route shares the public hostname too. Put the same value in the
# monitoring stack's secrets/metrics_token file (see that repo's README) so
# Prometheus can authenticate its scrapes.
METRICS_API_KEY=
