# --- LLM ---------------------------------------------------------------
# groq | anthropic
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Conversation store ----------------------------------------------
# Path to the SQLite history DB. Empty = in-memory, lost on restart.
# In Docker this points at the mounted volume.
CHECKPOINT_DB=

# --- Tavily ------------------------------------------------------------
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=5
TAVILY_SEARCH_DAYS=7

# --- Meta WhatsApp Cloud API (primary) ---------------------------------
# From Meta App dashboard -> WhatsApp -> API Setup
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
# Any string you invent; paste the same value into Meta's callback config.
META_VERIFY_TOKEN=
# App dashboard -> Settings -> Basic -> App Secret
META_APP_SECRET=
META_GRAPH_VERSION=v21.0
# Turn on once you have a stable https URL.
VALIDATE_META_SIGNATURE=false

# --- Twilio WhatsApp (alternative; needs an UPGRADED account) ----------
# Trial accounts cannot send custom replies: free-form REST returns
# 21654 ContentSid Required, the Content API is blocked, and inline TwiML
# is unsupported.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sandbox number. Replace once you have your own WhatsApp sender.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Set to true in production, and set PUBLIC_BASE_URL to your https origin
# exactly as Twilio calls it (e.g. https://abc123.ngrok-free.app).
VALIDATE_TWILIO_SIGNATURE=false
PUBLIC_BASE_URL=
